<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TadSyncLauncher</AssemblyName>
    <RootNamespace>TadSyncLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\botcore.exe" LogicalName="TadSyncLauncher.Assets.botcore.exe" />
  </ItemGroup>
  
</Project>
